{
  "manifest_version": 3,
  "name": "엔트리 터보 (비공식)",
  "version": "0.3.0.2",
  "version_name": "0.3.0-rc.2",
  "description": "엔트리 작품의 블록을 JS로 바꿔 빠르게 실행합니다. 결과는 원래 실행과 같게 맞춥니다.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "엔트리 터보",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "src/turbo.js",
        "src/osd.js",
        "src/smooth.js",
        "src/hires.js",
        "src/volume.js",
        "src/seed.js",
        "src/inspect.js",
        "src/main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
